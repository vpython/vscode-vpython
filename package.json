{
  "name": "vscode-vpython",
  "displayName": "VPython",
  "description": "Render VPython 3D scenes in VS Code notebooks (vpython-jupyter websocket frontend)",
  "version": "0.1.7",
  "publisher": "vpython",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vpython/vscode-vpython.git"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onRenderer:vpython-renderer"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Notebooks",
    "Visualization"
  ],
  "contributes": {
    "notebookRenderer": [
      {
        "id": "vpython-renderer",
        "displayName": "VPython Scene Renderer",
        "entrypoint": "./renderer.js",
        "mimeTypes": [
          "application/vnd.vpython.v1+json"
        ],
        "requiresMessaging": "optional"
      }
    ]
  }
}